# これは公開用テンプレート。コピーして python/.env を作り、そちらに実値を書く（.env はコミットされない）。
#   cp python/.env.example python/.env
#
# Pepper のIPアドレス（カンマ区切りで複数台可）。実機のIPに変更して python/.env に保存する。
# 実機が無い間はローカルのモックサーバ用に 127.0.0.1 のままでよい。
PEPPER_IPS=127.0.0.1
# Android アプリ側 TCP サーバのポート（MainActivity の PORT と一致させる）。
PEPPER_PORT=2003

# --- 低レベル NAOqi 直結用（naoqi_lowlevel.py / ALMotion など）。2.9 は認証必須 ---
# 実値（特に PEPPER_PASSWORD）は python/.env のみに書く。絶対にコミットしない。
PEPPER_NAOQI_PORT=9503     # NAOqi 2.9 のリモート接続ポート（TLS）
PEPPER_USER=nao            # ロボットのアカウント名（多くは nao）
PEPPER_PASSWORD=changeme   # ロボット設定で決めたパスワード（実値は .env に）
