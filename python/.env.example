# これは公開用テンプレート。コピーして python/.env を作り、そちらに実値を書く（.env はコミットされない）。
#   cp python/.env.example python/.env
#
# Pepper のIPアドレス（カンマ区切りで複数台可）。実機のIPに変更して python/.env に保存する。
# 実機が無い間はローカルのモックサーバ用に 127.0.0.1 のままでよい。
PEPPER_IPS=127.0.0.1
# Android アプリ側 TCP サーバのポート（MainActivity の PORT と一致させる）。
PEPPER_PORT=2003
